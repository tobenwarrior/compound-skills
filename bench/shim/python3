#!/usr/bin/python3 -I
"""Record Python runs with the project's source and test state before and after."""
from itertools import dropwhile
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from devtrace import digest  # noqa: E402


def snapshot(repo, *, exact):
    if repo is None:
        return "", ""
    try:
        return digest(repo, "src", exact=exact), digest(repo, "tests", exact=exact)
    except OSError:
        if exact:
            return None
        raise


def native_trace(root, log, args):
    flags = {"-B", "-E", "-I", "-s", "-S", "-u", "-q", "-v"}
    command = dropwhile(flags.__contains__, args)
    module = (next(command, None), next(command, None))
    if module not in (("-m", "pytest"), ("-m", "unittest")):
        return None
    root, log = Path(root or ""), Path(log or "")
    if not root.is_absolute() or not log.is_absolute():
        return None
    try:
        root, log = root.resolve(strict=True), log.resolve()
        if Path.cwd().is_relative_to(root) and not log.is_relative_to(root):
            return root, log
    except (OSError, RuntimeError):
        return None
    return None


args = ["-m", "pytest", *sys.argv[1:]] if Path(sys.argv[0]).name in ("pytest", "py.test") else sys.argv[1:]
root = os.environ.get("COMPOUND_BENCH_TRACE_ROOT")
log = os.environ.get("COMPOUND_BENCH_TRACE_LOG")
exact = root is not None or log is not None
if exact:
    trace = native_trace(root, log, args)
    if trace is None:
        os.execv(sys.executable, [sys.executable, *args])
    repo, log = trace
else:
    sources = Path("/home", "dev", "src")
    log = Path("/home", ".devtrace", "exec.jsonl")
    projects = [p for p in sources.iterdir() if p.is_dir()] if sources.is_dir() else []
    repo = projects[0] if len(projects) == 1 else None
before = snapshot(repo, exact=exact)
started = time.time()
try:
    code = subprocess.call([sys.executable, *args])
except KeyboardInterrupt:
    code = 130
after = snapshot(repo, exact=exact)
if before is not None and after is not None:
    record = {"t0": started, "t1": time.time(), "argv": args, "cwd": os.getcwd(), "exit": code,
              "src0": before[0], "tests0": before[1], "src1": after[0], "tests1": after[1]}
    if exact:
        record["source_digest"] = "bytes"
    try:
        with log.open("a") as stream:
            stream.write(json.dumps(record) + "\n")
    except OSError:
        pass
sys.exit(code)
