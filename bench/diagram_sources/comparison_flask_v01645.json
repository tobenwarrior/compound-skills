      "tasks": [
        {
          "name": "flask-ipv6-session",
          "prompt": "Our tests use the Flask test client with base_url=\"http://[::1]:8000/\". A value we set inside client.session_transaction(base_url=...) never reaches the app: the next client.get(\"/\", base_url=...) sees an empty session. With base_url \"http://localhost:8000/\" the same test passes. Fix the bug and add a regression test that fails before this change. Preserve existing fixes and tests."
        },
        {
          "name": "flask-ipv6-run",
          "prompt": "Our Flask app sets SERVER_NAME to \"[::1]:8080\" so the development server listens on IPv6 localhost, but app.run() crashes before the server starts with \"ValueError: invalid literal for int() with base 10: ':1]:8080'\". With SERVER_NAME set to \"localhost:8080\" it starts fine. Fix the bug and add a regression test that fails before this change. Preserve existing fixes and tests."
        }
      ]
    }
